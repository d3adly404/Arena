{
  "name": "novase-browser",
  "version": "1.0.0",
  "description": "Novase - A sleek modern browser with built-in games and media downloader",
  "main": "electron-main.js",
  "author": "Novase Team",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win --linux --mac",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.novase.browser",
    "productName": "Novase Browser",
    "copyright": "Copyright © 2026 Novase",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "server.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/node_modules/.cache",
      "!dist",
      "!.git"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "Novase-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Novase Browser",
      "include": "build-resources/installer.nsh"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build-resources/icon.png",
      "category": "Network"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build-resources/icon.png",
      "category": "public.app-category.utilities"
    }
  }
}
